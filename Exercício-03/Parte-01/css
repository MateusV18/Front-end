/* Resete básico */
* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}

/* Teste visual no Body e Tipografia Geral */
body {
  font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
  background-color: #f8fafc;
  color: #1e293b;
  line-height: 1.6;
}

/* Estilização do Cabeçalho e Navegação */
header {
  background-color: #cc0000; /* Vermelho Pokebola */
  color: #ffffff;
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 1rem 2rem;
  border-bottom: 4px solid #111111;
}

header .logo {
  font-size: 1.6rem;
  font-weight: bold;
  color: #ffcb05; /* Amarelo clássico Pokémon */
  text-transform: uppercase;
  letter-spacing: 1px;
}

nav ul {
  display: flex;
  list-style: none;
  gap: 1.5rem;
}

nav a {
  color: #ffffff;
  text-decoration: none;
  font-weight: 600;
}

nav a:hover {
  color: #ffcb05;
}

/* Seções Gerais */
.secao {
  padding: 3rem 2rem;
  max-width: 900px;
  margin: auto;
}

h1, h2 {
  color: #cc0000; /* Teste visual nos títulos */
  margin-bottom: 1rem;
}

/* Seção Hero */
.hero {
  background-color: #2a75bb; /* Azul Pokémon */
  color: #ffffff;
  text-align: center;
  padding: 4rem 2rem;
  border-bottom: 4px solid #3c5aa6;
}

.hero h1 {
  color: #ffcb05; /* Título no Hero em Amarelo */
  font-size: 2.2rem;
  text-shadow: 2px 2px #3c5aa6;
}

.hero p {
  font-size: 1.2rem;
  margin-bottom: 1.5rem;
}

.btn {
  display: inline-block;
  background-color: #ffcb05;
  color: #111111;
  padding: 0.75rem 1.5rem;
  text-decoration: none;
  border-radius: 20px;
  font-weight: bold;
}

.btn:hover {
  background-color: #e6b800;
}

/* Estilo da lista na seção recursos */
.secao ul {
  list-style: none;
}

.secao li {
  background-color: #ffffff;
  margin-bottom: 0.75rem;
  padding: 1rem;
  border-left: 5px solid #cc0000;
  border-radius: 4px;
}

/* Estilo do Rodapé */
footer {
  background-color: #111111;
  color: #94a3b8;
  text-align: center;
  padding: 1.5rem;
  margin-top: 2rem;
  border-top: 3px solid #cc0000;
}

footer strong {
  color: #ffcb05;
}
